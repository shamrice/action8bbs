MODULE
;set uname before checking pass!
;uname can be used in main app
BYTE ARRAY UNAME(10)
BYTE ARRAY UATTR(32)

; word wrap string buffer and flag
BYTE ARRAY WWSB(10)
BYTE WWSB_V = [0]

;converts two byte ATASCII to
;byte number
BYTE FUNC atob(BYTE n1,n2)
  BYTE val=[0]
  val=0

  IF n1 = 32 AND n2 = 32 THEN
    RETURN(0)
  FI

  n1==-48

  IF n2 <> 32 AND n2 <> 155 THEN
    n1==*10
    n2==-48
    n1==+n2
  FI

  val=n1
RETURN(val)




BYTE FUNC UCase(BYTE ch)
  IF ch > 96 THEN
    ch==-32
  FI
RETURN (ch)




; Needs to be in UTIL as requires
; both TIME and NETWORK...
;
BYTE FUNC NGetB()
  nv = 0
  nc = 0

  WHILE nv = 0
  DO
    NStatus()
    IF IS_CONN = 0 THEN
      PrintE("NGetB after conn drop!")
      RETURN(0)
    FI

    IF BYTESWAITING > 0 THEN
      NRead(NSB, 1)
      NGetStatus()
      IF ERRNO <> 1 THEN
        PrintF("Read err: %B%E",ERRNO)
        IS_CONN = 0
        EXIT
      FI
      nc = NSB(0)
      IF (nc >= 32 AND nc <=124) OR nc=155 THEN
        nv = 1
      ELSE
        PrintF("NGetB_IGNORE:%B%C%E",nc,nc)
      FI
    ELSE
      IF TSessExp() = 1 THEN
        EXIT
      FI
    FI
  OD
RETURN (nc)



PROC NPrintFile(BYTE ARRAY file)
  BYTE l=[0]
  c = 0
  l = 0
  i = 0

  NPutC(125)

  PrintF("Open and sending: %S%E",file)

  FOpen(FIOCB,file,4)

  WHILE IS_CONN = 1
  DO
    NSuspend()
    InputSD(FIOCB,RXBUFF)
    NResume()

    NWriteSE(RXBUFF)

    IF EOF(FIOCB) <> 0 THEN
      EXIT
    FI

    l==+1

    IF l > 21 THEN
      l = 0

      IF c <> 'C THEN
        NWriteS("[MORE, Continuous, Exit]")
        c = NGetB()
        c = UCase(c)
        FOR v = 0 TO 23
        DO
          NSB(v) = 126
        OD
        NWrite(NSB,24)
        IF c = 'X THEN
          NPutC(155)
          EXIT
        FI
      FI
    ELSE
      NStatus()

      IF BYTESWAITING > 0 THEN
        NResume()
        NRead(NSB, 1)
        IF NSB(0) = 3 THEN
          EXIT
        FI
      FI

    FI
  OD

  FClose(FIOCB)

RETURN


CARD FUNC ReadInp()
  CARD readLen=[0]

  NStatus()

  IF BYTESWAITING = 0 OR IS_CONN = 0 THEN
    RETURN (0)
  FI

  IF BYTESWAITING > 38 THEN
    BYTESWAITING = 38
  FI
  readLen = BYTESWAITING
  NRead(NSB,readLen)

RETURN (readLen)


;returns idx of last char
BYTE FUNC GetInp()
  BYTE checkC=[0],lastSpace=[0]
  CARD readLen=[0]

  lastSpace = 0
  readLen = 0
  c = 0
  checkC = 0

  NResume()

  FOR i = 0 TO 39
  DO
    IF ALLOW_WW = 1 AND i < 10 THEN
      IF WWSB_V = 1 AND WWSB(i) <> 32 THEN
        RXBUFF(i) = WWSB(i)
        c==+1
      ELSE
        RXBUFF(i) = 32
      FI
      WWSB(i) = 32 ; clear it
    ELSE
      RXBUFF(i) = 32
    FI
    NSB(i) = 32
  OD

  IF ALLOW_WW = 1 AND WWSB_V = 1 THEN
    NWrite(RXBUFF, c)
  FI

  WWSB_V = 0

  IF IS_CONN = 0 THEN
    RETURN(0)
  FI

  WHILE IS_CONN = 1
  DO
    readlen = ReadInp()

    IF readLen > 0 THEN

      readLen==-1
      FOR i = 0 TO readLen
      DO

        IF NSB(i) = 155 THEN
          NPutC(155)
          RETURN (c)
        ELSEIF NSB(i) = 126 AND c > 0 THEN
          NPutC(126)
          c==-1
          RXBUFF(c) = 32
        ELSEIF c < 38 THEN

          ;allow inverse text when
          ;not in gfx mode if flagged
          checkC = NSB(i)
          IF ALLOW_INVERTED=1 AND checkC >= 128 THEN checkC ==- 128 FI

          IF GFXMODE = 0 AND (checkC < 32 OR checkC > 122) THEN
            ; IGNORE
          ELSE
            IF NSB(i)=32 THEN
              lastSpace = c
            FI
            RXBUFF(c) = NSB(i)
            IF IMASK > 0 THEN
              NSB(i) = IMASK
            FI
            NPutC(NSB(i))
            c==+1
          FI
        ELSEIF ALLOW_WW = 1 AND c >= 38 AND lastSpace>28 THEN
          IF NSB(i) <> 32 THEN

            checkC = NSB(i)
            c=0
            lastSpace==+1
            FOR i = lastSpace TO 37
            DO
              NSB(c) = 126
              WWSB(c)=RXBUFF(i)
              RXBUFF(i) = 32
              c==+1
            OD
            WWSB(c) = checkC
            NSB(c) = 155
            NWrite(NSB,c+1)
            WWSB_V = 1

          ELSE
            NPutC(155)
          FI
          RETURN(38)
        FI
      OD
    ELSE
      IF TSessExp() = 1 THEN
        RETURN(c)
      FI
    FI
  OD
RETURN(c)

