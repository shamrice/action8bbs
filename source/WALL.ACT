PROC Wall()
  BYTE maxI=[0]
  maxI=0

  NPrintFile("D2:WALL.DAT")

  NWriteS("Add to the wall [n]? ")
  c = NGetB()
  NPutE(2)

  IF UCase(c) <> 'Y THEN
    RETURN
  FI

  NWriteSE("Enter new wall text:")

  ALLOW_INVERTED = 1
  maxI = GetInp()
  ALLOW_INVERTED = 0

  IF RXBUFF(0) = 32 THEN
    NWriteSE("Not adding entry..")
    NPutC(155)
    RETURN
  FI

  NPutC(155)
  NWriteSE("Saving...")

  FOpen(5,"D2:WALL.DAT",9)

  FOR i = 0 TO 9
  DO
    c = UNAME(i) + 128
    PutD(5,c)
  OD

  NSB(0) = maxI
  FOR i = 0 TO maxI
  DO
    NSB(i+1) = RXBUFF(i)
  OD

  PutD(5,155)
  PrintDE(5,NSB)
  PutD(5,155)

  FClose(5)

  NWriteSE("Wall entry added!")
  NPutC(155)

RETURN


