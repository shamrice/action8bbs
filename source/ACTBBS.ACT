; Action!8! BBS - XM301 DIAL UP
;
; Start Date: 2025-07-11
; Last update: 2026-07-14
;
;
BYTE RTS = [$60]

;INCLUDE "D1:SYSBBS.ACT"

MODULE

DEFINE FIOCB="6"
BYTE IMASK=[0],ALLOW_INVERTED=[0]
BYTE GFXMODE=[0],UCLOG=[0],ALLOW_WW=[0]
BYTE c=[0],i=[0],v=[0]

BYTE ARRAY lOffset(25)
CARD ARRAY lSect(25)

INCLUDE "D1:NETFUJI.ACT"
;INCLUDE "D1:NETMODEM.ACT"
INCLUDE "D1:TIME.ACT"
INCLUDE "D1:FILE.ACT"
INCLUDE "D1:UTIL.ACT"
INCLUDE "D1:MSGBASE1.ACT"
INCLUDE "D1:MSGBASE2.ACT"
INCLUDE "D1:MSGBASE3.ACT"
INCLUDE "D1:ACCT1.ACT"
INCLUDE "D1:ACCTATTR.ACT"
INCLUDE "D1:WALL.ACT"
INCLUDE "D1:NEBBSAPI.ACT"
INCLUDE "D1:SURVEY.ACT"
INCLUDE "D1:JOKEOTD.ACT"


PROC AcceptConn()
  BYTE KB = $02FC

; Close(2)
; Open(2,"K:",4,0)

  PrintE("Waiting. Press # to shutdown")

  WHILE IS_CONN = 0
  DO
    TSleep(10)

    NCmd('A)
    NGetStatus()
    IF ERRNO = 1 THEN
      PutE()
      PrintE("CONNECT")
      IS_CONN = 1
      GFXMODE = 0
      IGNORE_CONN_CLOSED = 0
      ALLOW_INVERTED = 0
      ALLOW_WW = 0
      ; reset session timer..
      TSEXP = TS + 1

      NStatus()
    ELSE
      IF KB <> $FF THEN
        PrintE("Checking key press")
        FOpen(2,"K:",4)
        Print("PRESS 1 TO SHUTDOWN: ")
        c = InputB()
        FClose(2)
        PrintF("Keypress=%B %C%E",c,c)
        IF c = 1 THEN
          PrintE("WARN! Server shutdown!")
          IS_CONN = 0
          IMASK = '#
          EXIT
        FI
      FI
    FI
  OD

; Close(2)
RETURN


PROC HandleUserConn()
  c = 0
  v = 0

  IF DoLogin() = 0 THEN
    IS_CONN = 0
    RETURN
  FI

  UCLOG = 1
  TSEXP = TS + 2

  SetUAttr()

  ;increment login count
  UATTR(4)==+1
  IF UATTR(4) = 0 THEN
    UATTR(3)==+1
  FI

  NPrintFile("D1:TITLED.ATA")

  NWriteSE("Press ? for help")

;  IF UATTR(10) = 1 THEN
;    NPrintFile("D1:MAINMENU.ATA")
;  ELSE
;    NPrintFile("D1:MAINMENS.ATA")
;  FI

  c = 0

  WHILE IS_CONN = 1
  DO
    NWriteS("MAIN> ")
    c = NGetB()

    IF c >= 97 THEN
      c==-32
    FI

    IF c = 'G THEN
      NPrintFile("D1:LOGOUT.ATA")
      IS_CONN = 0

    ELSEIF c = 'C THEN
      NPrintFile("D2:CALL.LOG")

    ELSEIF c = 'P THEN
      PostMsg(255) ;255 = no parent

    ELSEIF c = 'R THEN
      ReadMsgs()

    ELSEIF c = 'B THEN
      NPrintFile("D2:SYSINFO.TXT")

    ELSEIF c = '/ THEN
      UAttrConfig()

    ELSEIF c = 'U THEN
      NPrintFile(ULNAME)

    ELSEIF c = 'W THEN
      Wall()

    ELSEIF c = 'S THEN
      SurveyMenu()

    ELSEIF c = 'J THEN
       JokeOTD()

    ELSEIF c = 'I THEN
      NPutC(155)
      NWriteSE("Sorry, no easter egg this time!")
      NWriteSE("...ran out of disk space!")
      NPutC(155)
;     NPrintFile("D1:INFIL.ATA")

    ELSEIF c = '? THEN
      IF UATTR(10) = 1 THEN
        NPrintFile("D1:MAINMEDU.ATA")
      ELSE
        NPrintFile("D1:MAINMEDS.ATA")
      FI

    ELSEIF c = 'N THEN
      NELatest()

    ELSEIF c = 'D THEN
      NPutC(155)
      IF UATTR(9) = 255 THEN
        NWriteS("Set Date/Time [n]? ")
        c = NGetB()
        NPutC(155)
        IF c = 'Y or c = 'y THEN
          NSetDT()
          NPutC(155)
        FI
      FI
      NWriteS("Current time: ")
      NGetDT()
      RXBUFF(0)=16
      NWriteSE(RXBUFF)
      NPutC(155)

    ELSEIF c = '# THEN
      IF UATTR(9) = 255 THEN
        IS_CONN = 0
        IMASK = '#
        PrintE("WARN>> Server shutdown by user!")
      FI
    ELSE
      NWriteSE("Press ? for help")
    FI

  OD
RETURN


PROC Main()
  Put(125)
  PrintE("           ACTION8BBS             ")
  Print("Closing IOCBs...")
  Close(1)
  Close(2)
  Close(3)
  Close(4)
  Close(5)
  Close(FIOCB)
  PrintE("Done")

  SetHIMSG()
  IMASK=0
  IS_CONN = 0

  IF NInit() <> 1 THEN
    PrintE("INIT FAILED!")
    RETURN
  FI

  DO
    UCLOG = 0
    AcceptConn()

    IF IS_CONN = 1 THEN
      HandleUserConn()
      TSleep(30)
      NCmd('c)
    FI

    IF IMASK = '# THEN
      EXIT
    FI

    IF UCLOG = 1 THEN
      Print("LOGOFF DATE: ")
      NGetDT()
      Print("LOGOFF USER: ")
      FOR i = 0 TO 9
      DO
        RXBUFF(i+18) = UNAME(i)
        Put(UNAME(i))
      OD
      PutE()
      AppendFile("D2:CALL.LOG",RXBUFF,27)
      SaveUAttr()
      PrintE("User session finished.")
    FI
    PutE()
  OD

  PrintE("Closing IOCB on exit")
  Close(FIOCB)

  NCmd('C)

  PrintE("Server offline.")


RETURN

