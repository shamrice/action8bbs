
PROC JokeOTD()
  BYTE jFound=[0]

  jFound = 0

  NPutE(2)
  NWriteSE("> JKE F THE DAY <")
  NPutC(155)

  NGetDT()
  v = NSB(0) ; day

  PrintF("view joke=%B%E",v)

  FOpen(5,"D2:JOKES.DAT",4)

  i = 0
  DO
    IF EOF(5) <> 0 THEN
      EXIT
    FI

    InputMD(5,RXBUFF,38)

    c=(i/2)+1

    IF c = v THEN
      NResume()
      NWriteSE(RXBUFF)
      NSuspend()
      jFound==+1
      IF jFound = 2 THEN EXIT FI
    FI

    i==+1
  OD
  FClose(5)

  NPutC(155)

RETURN

