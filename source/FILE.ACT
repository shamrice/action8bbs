
PROC FOpen(BYTE iocb, BYTE ARRAY name, BYTE mode)
  PrintF("OPEN:%B : %S%E",iocb,name)

  NSuspend()
  Close(iocb)
  Open(iocb,name,mode,0)
RETURN



PROC FClose(BYTE iocb)
  PrintF("CLOSE:%B%E",iocb)

  NSuspend()
  Close(iocb)
  NResume()
RETURN


PROC AppendFile(BYTE ARRAY file, BYTE ARRAY txt, BYTE len)

  PrintF("Appending %S with %S :len%B%E",file,txt,len)
  FOpen(FIOCB,file,9)

  FOR i = 0 TO len
  DO
    PutD(FIOCB,txt(i))
  OD
  PutD(FIOCB,155)

  FClose(FIOCB)
RETURN

